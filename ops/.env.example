# Скопируйте в ops/.env и заполните. ops/.env в git НЕ попадает.
#
# 1. Токен бота: напишите @BotFather в Telegram → /newbot → следуйте шагам.
#    Он выдаст строку вида 1234567890:AAH... — это она.
CASHMASH_TG_TOKEN=

# 2. Идентификатор чата: напишите своему боту любое сообщение, затем
#       python ops/alert_agent.py --chat-id-help
#    и вставьте выданное значение сюда.
CASHMASH_TG_CHAT_ID=

# --- Ключи биржи ---
# Вручную сюда писать не нужно: робот запишет их сам после проверки.
#
#     python ops/bybit_login.py          подключить счёт (testnet)
#     python ops/bybit_login.py --status что подключено сейчас
#     python ops/bybit_login.py --logout забыть ключ
#
# То же самое есть в панели — карточка «Подключение биржи»; ключ там
# принимается только с самой машины робота.
#
# Права ключа: ТОЛЬКО Trade. Withdraw — никогда: ключ с правом вывода
# робот не примет (docs/10-Security.md, 10.2). Привязка к IP обязательна.
# Сначала testnet: ключи testnet и mainnet разные и невзаимозаменяемы.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true
