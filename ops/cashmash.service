[Unit]
Description=CashMash trading bot
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cashmash
ExecStart=/usr/bin/docker compose -f ops/docker-compose.yml up
ExecStop=/usr/bin/docker compose -f ops/docker-compose.yml down

# Перезапуск с ограничением: бесконечный цикл хуже остановки — он маскирует
# причину и жжёт лимиты биржи (docs/09, 9.5).
Restart=always
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=600

# Часы обязаны быть синхронны: Bybit отклоняет запросы с расхождением
# времени, и симптом выглядит как «работало и вдруг перестало».
ExecStartPre=/usr/bin/timedatectl set-ntp true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
