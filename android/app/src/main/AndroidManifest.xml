<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Экран гаснет — процесс обязан жить. Без этого Android усыпляет
         сеть через минуты, и робот просыпается с разорванным потоком
         котировок, не зная, что он что-то пропустил. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Тип службы выбран specialUse, а не dataSync, и это не уловка.
         С Android 15 службы типа dataSync живут не больше 6 часов
         в сутки: система сама их гасит. Робот, который замолкает в
         середине дня и не говорит почему, хуже робота, которого нет.
         specialUse такого потолка не имеет; плата за это — приложение
         нельзя опубликовать в Google Play без обоснования, что для
         личной сборки и не нужно. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".RobotApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.CashMash"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Отдаёт наружу один выбранный файл журнала. Список путей
             (xml/file_paths.xml) ограничен каталогом логов: ops/.env
             лежит рядом, но через провайдер недоступен. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Робот живёт в ОТДЕЛЬНОМ процессе, и это главное решение всей
             сборки. Службы внутри него — потоки: упавший поток или
             утечка памяти в одном из них не должны уносить экран, а
             остановка робота не должна закрывать приложение. Разговаривают
             процессы через ту же локальную панель, что и на компьютере, —
             никакого отдельного протокола для этого не понадобилось. -->
        <service
            android:name=".BotService"
            android:exported="false"
            android:process=":bot"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Непрерывное наблюдение за биржевым стаканом и сопровождение открытой позиции: пропуск данных нельзя наверстать позже, а брошенная позиция остаётся без стопа." />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:process=":bot"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
