<?xml version="1.0" encoding="utf-8"?>
<!--
  Открытый HTTP разрешён РОВНО для петлевого адреса — панели, которую
  приложение показывает у самого себя. Всё остальное (Bybit, Telegram,
  новостные ленты) ходит только по HTTPS: разрешить cleartext целиком
  значило бы позволить подменить котировки в любой публичной сети.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
