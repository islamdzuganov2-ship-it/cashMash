<?xml version="1.0" encoding="utf-8"?>
<!--
  Вкладка «Робот» отвечает на один вопрос: что сейчас происходит и
  почему. Раньше это была одна обрезанная строка вверху экрана
  («Работает служб: 3 · не поднялись: alerts»), из которой нельзя было
  понять ни какая служба отказала, ни по какой причине.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/headnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="@color/text_dim" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/robot_services" />

        <LinearLayout
            android:id="@+id/services"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/servicesEmpty"
            style="@style/Hint"
            android:text="@string/robot_services_empty" />

        <TextView
            style="@style/SectionTitle"
            android:text="@string/robot_conditions" />

        <TextView
            android:id="@+id/network"
            style="@style/Hint"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/storage"
            style="@style/Hint"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/address"
            style="@style/Hint" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="20dp"
            android:text="@string/robot_footnote" />
    </LinearLayout>
</ScrollView>
