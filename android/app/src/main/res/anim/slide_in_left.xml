<?xml version="1.0" encoding="utf-8"?>
<!-- Переход между вкладками: сдвиг по направлению перехода плюс
     проявление. Направление важно — оно говорит, куда ты пошёл, и
     возврат ощущается возвратом. Уходящий экран смещается меньше
     приходящего: так взгляд остаётся на том, что появляется. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <translate
        android:fromXDelta="-100%"
        android:toXDelta="0%"
        android:duration="220" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="180" />
</set>
