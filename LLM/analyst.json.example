{
  "_": [
    "Настройки аналитика. Скопировать в LLM/analyst.json и править —",
    "файл необязателен, без него работают умолчания из analyst/config.py.",
    "",
    "МОДЕЛЬ",
    "  gguf          пусто = взять единственный .gguf из LLM/. Имя модели",
    "                нигде не зашито: замена файла меняет модель.",
    "                После замены ОБЯЗАТЕЛЬНО прогнать check — другая",
    "                модель означает другое качество, и прежняя оценка",
    "                к ней не относится.",
    "  backend       auto | llama-server | lmstudio | ollama | llama-cpp",
    "                auto перебирает в порядке «не копировать веса».",
    "  n_ctx         окно модели. Должно совпадать с тем, с каким она",
    "                поднята на сервере: подсказка длиннее окна не",
    "                обрезается, а отвергается целиком.",
    "  temperature   ноль и менять незачем. Это не осторожность, а",
    "                условие проверяемости: отчёт, который на тех же",
    "                данных выходит другим, невозможно сверить.",
    "  reasoning_effort  «none» — рассуждающая модель тратит на «подумать»",
    "                тот же лимит токенов, из которого должен выйти",
    "                ответ, и возвращает пустоту. Этой задаче",
    "                рассуждение не нужно: модель не решает задачу, а",
    "                связывает готовые факты. Пустая строка — не слать",
    "                параметр вовсе.",
    "",
    "ПОРОГИ",
    "  min_sample            ниже этого числа сделок разрез не обсуждается",
    "  min_trades_for_lora   порог для дообучения весов. Снижать — значит",
    "                        менять не настройку, а вид работы: ниже",
    "                        порога получается имитация интонации аналитика",
    "  min_grounding         доля выводов, переживших контроль, ниже",
    "                        которой отчёт помечается ненадёжным",
    "  min_refusal_rate      доля правильных отказов. Единица, и снижать",
    "                        её нельзя: способность сказать «не знаю» —",
    "                        то, что отличает анализ от сочинения",
    "  daily_hour_utc        час суточного разбора. 21 — после того, как",
    "                        спадает активность рынка (docs/24)"
  ],

  "symbol": "XRPUSDT",

  "model": {
    "gguf": "",
    "backend": "auto",
    "server_url": "http://127.0.0.1:8080",
    "ollama_url": "http://127.0.0.1:11434",
    "ollama_model": "cashmash-analyst",
    "n_ctx": 8192,
    "n_gpu_layers": -1,
    "temperature": 0.0,
    "top_p": 1.0,
    "seed": 1,
    "max_tokens": 1400,
    "request_timeout_sec": 900
  },

  "thresholds": {
    "min_sample": 12,
    "min_trades_for_lora": 500,
    "number_tolerance": 0.01,
    "max_regenerations": 2,
    "min_grounding": 0.85,
    "min_eval_score": 0.80,
    "min_refusal_rate": 1.0,
    "eval_max_age_hours": 336,
    "bootstrap_samples": 2000,
    "confidence": 0.95,
    "daily_hour_utc": 21,
    "min_hours_between_runs": 20
  }
}
